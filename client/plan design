// server/services/emailService.js
let nodemailer;
try { nodemailer = require('nodemailer'); } catch (e) { nodemailer = null; }
async function sendIndividualTaskEmails({ teamMembers, projectName, planData }) {
  const results = [];
  for (const member of teamMembers) {
    if (!member.email || !member.email.trim()) continue;
    // Filter tasks assigned to this developer
    const assignedTasks = [];
    (planData.phases || []).forEach((phase) => {
      (phase.tasks || []).forEach((task) => {
        if (task.assignedToEmail === member.email) {
          assignedTasks.push({ phaseName: phase.name, ...task });
        }
      });
    });
    const htmlBody = `
      <div style="font-family: Arial, sans-serif; background-color: #0f172a; color: #f8fafc; padding: 20px; border-radius: 10px;">
        <h2 style="color: #818cf8;">Hi ${member.name}, your sprint task list for: ${projectName}</h2>
        <p><strong>Role:</strong> ${member.role} | <strong>Assigned Tasks:</strong> ${assignedTasks.length}</p>
        <ul style="line-height: 1.8;">
          ${assignedTasks.map(t => `<li><strong>[${t.phaseName}]</strong> ${t.title} <em>(${t.estimatedDays} days)</em></li>`).join('')}
        </ul>
      </div>
    `;
    let sentStatus = 'Mock Mode';
    if (process.env.EMAIL_USER && process.env.EMAIL_PASS && nodemailer) {
      try {
        const transporter = nodemailer.createTransport({
          service: process.env.EMAIL_SERVICE || 'gmail',
          auth: { user: process.env.EMAIL_USER, pass: process.env.EMAIL_PASS }
        });
        await transporter.sendMail({
          from: `"AI Project Planner" <${process.env.EMAIL_USER}>`,
          to: member.email,
          subject: `🎯 Your Tasks for ${projectName}`,
          html: htmlBody
        });
        sentStatus = 'Real SMTP';
      } catch (err) {
        console.warn(`SMTP error for ${member.email}: ${err.message}`);
      }
    }
    results.push({
      developer: member.name,
      email: member.email,
      role: member.role,
      assignedCount: assignedTasks.length,
      status: sentStatus
    });
  }
  return results;
}
